{
  "name": "nativescript-mason-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nativescript-mason-core",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/tools/mason-core/**/*", "{workspaceRoot}/LICENSE", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/packages/nativescript-mason-core"],
      "options": { "command": "node tools/mason-core/build-core.mjs" }
    },
    "build.all": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node -e \"console.log('Core prototype build complete; native hosts are not included.')\"" }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-package.mjs" }
    }
  }
}
