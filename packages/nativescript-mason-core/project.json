{
  "name": "nativescript-mason-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nativescript-mason-core",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/tools/mason-core/**/*", "{workspaceRoot}/LICENSE", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/packages/nativescript-mason-core"],
      "options": { "command": "node tools/mason-core/build-core.mjs" }
    },
    "build.all": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node -e \"console.log('Core prototype build complete; native hosts are not included.')\"" }
    },
    "build.runtime": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/prototypes/nativescript-mason-core"],
      "options": { "command": "node tools/mason-core/build-runtime.mjs" }
    },
    "verify.runtime": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.runtime", { "target": "build", "projects": ["nativescript-masonkit"] }],
      "cache": false,
      "options": {
        "commands": ["node tools/mason-core/verify-runtime.mjs", "vitest run --config tools/mason-core/vitest-runtime.config.ts"],
        "parallel": false
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-package.mjs" }
    },
    "build.native.host": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs host" }
    },
    "build.native.ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs ios" }
    },
    "build.native.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs android" }
    },
    "verify.native": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.host"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-native.mjs" }
    },
    "verify.native.ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-native-ios.mjs" }
    }
  }
}
