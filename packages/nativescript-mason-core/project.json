{
  "name": "nativescript-mason-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nativescript-mason-core",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/tools/mason-core/**/*", "{workspaceRoot}/LICENSE", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/packages/nativescript-mason-core"],
      "options": { "command": "node tools/mason-core/build-core.mjs" }
    },
    "build.all": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node -e \"console.log('Core prototype build complete; native hosts are not included.')\"" }
    },
    "build.runtime": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/prototypes/nativescript-mason-core"],
      "options": { "command": "node tools/mason-core/build-runtime.mjs" }
    },
    "build.plugin.prototype": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.runtime"],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/prototypes/nativescript-mason-core-plugin"],
      "options": { "command": "node tools/mason-core/build-plugin.mjs" }
    },
    "generate.native.types": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/generate-native-types.mjs" }
    },
    "verify.plugin.prototype": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.plugin.prototype"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-plugin.mjs" }
    },
    "verify.runtime": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.runtime", { "target": "build", "projects": ["nativescript-masonkit"] }],
      "cache": false,
      "options": {
        "commands": ["node tools/mason-core/verify-runtime.mjs", "vitest run --config tools/mason-core/vitest-runtime.config.ts"],
        "parallel": false
      }
    },
    "prepare.consumer": {
      "executor": "nx:run-commands",
      "dependsOn": ["verify.plugin.prototype"],
      "cache": false,
      "options": { "command": "node tools/mason-core/prepare-consumer.mjs" }
    },
    "build.consumer.ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-consumer.mjs ios" }
    },
    "prepare.consumer.renderer": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare.consumer"],
      "cache": false,
      "options": { "command": "node tools/mason-core/prepare-renderer-consumer.mjs" }
    },
    "prepare.consumer.renderer.control": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare.consumer"],
      "cache": false,
      "options": { "command": "node tools/mason-core/prepare-renderer-consumer.mjs --native-only" }
    },
    "prepare.consumer.compiled": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare.consumer.renderer"],
      "cache": false,
      "options": { "command": "node tools/mason-core/prepare-compiled-consumer.mjs" }
    },
    "build.consumer.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-consumer.mjs android" }
    },
    "test.consumer.ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-ios-consumer.mjs" }
    },
    "test.consumer.android.device": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-android-consumer.mjs" }
    },
    "test.consumer.android.emulator": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-android-tests.mjs --consumer" }
    },
    "test.consumer.ios.input": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "node tools/mason-core/run-ios-consumer.mjs --os-input" }
    },
    "test.consumer.android.input.emulator": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "node tools/mason-core/run-android-tests.mjs --consumer --os-input" }
    },
    "test.consumer.android.input.device": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "node tools/mason-core/run-android-consumer.mjs --os-input" }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-package.mjs" }
    },
    "build.native.host": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs host" }
    },
    "build.native.ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs ios" }
    },
    "build.host.ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/build-ios-host.mjs" }
    },
    "build.host.ios.device": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/build-ios-host.mjs --device" }
    },
    "verify.host.ios.device.artifact": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.host.ios.device"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-ios-host.mjs release --device" }
    },
    "build.tests.ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/build-ios-host.mjs --tests" }
    },
    "verify.host.ios.artifact": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.host.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-ios-host.mjs" }
    },
    "test.host.ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-ios-tests.mjs" }
    },
    "build.native.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-native.mjs android" }
    },
    "build.jni.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/build-android-jni.mjs" }
    },
    "prepare.parser.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/kotlin-source.mjs --bootstrap" }
    },
    "build.host.android": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.jni.android"],
      "cache": false,
      "options": { "command": "node tools/mason-core/build-android-host.mjs" }
    },
    "build.tests.android": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.jni.android"],
      "cache": false,
      "options": { "command": "node tools/mason-core/build-android-host.mjs --tests" }
    },
    "verify.host.android.artifact": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.host.android"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-android-host.mjs" }
    },
    "test.host.android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-android-tests.mjs" }
    },
    "test.host.android.device": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/mason-core/run-android-device-tests.mjs" }
    },
    "verify.native": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.host"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-native.mjs" }
    },
    "verify.native.ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["build.native.ios"],
      "cache": false,
      "options": { "command": "node tools/mason-core/verify-native-ios.mjs" }
    }
  }
}
